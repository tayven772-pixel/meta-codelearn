{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/sign-in", "destination": "/index.html" },
    { "source": "/sign-in/(.*)", "destination": "/index.html" },
    { "source": "/sign-up", "destination": "/index.html" },
    { "source": "/sign-up/(.*)", "destination": "/index.html" },
    { "source": "/user-portal", "destination": "/index.html" },
    { "source": "/account", "destination": "/index.html" },
    { "source": "/learn/(.*)", "destination": "/index.html" }
  ]
}